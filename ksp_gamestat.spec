    hiddenimports=[
        'flask',
        'flask_cors',
        'werkzeug',
        'werkzeug.serving',
        'werkzeug.middleware.proxy_fix',
        'jinja2',
        'jinja2.ext',
        'click',
        'itsdangerous',
        'blinker',
        'markupsafe',
        'sfs_parser',
        'database',
        'sqlite3',
        'threading',
        'hashlib',
        'math',
    ],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
        'tkinter',
        'matplotlib',
        'numpy',
        'pandas',
        'test',
        'unittest',
        'doctest',
    ],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=block_cipher,
    noarchive=False,
