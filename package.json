{
  "name": "ksp-gamestat",
  "productName": "KSP GameStats",
  "version": "1.0.0",
  "description": "Kerbal Space Program mission statistics dashboard",
  "main": "electron/main.js",
  "author": {
    "name": "Silvestro 'Pino' Di Pietro",
    "email": "sdipietr@mac.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.6",
    "express": "^4.22.3"
  },
  "build": {
    "appId": "com.sdipietro.ksp-gamestat",
    "productName": "KSP GameStats",
    "copyright": "Copyright Silvestro Di Pietro © 2026",
    "files": [
      "electron/**/*",
      "!dist/**",
      "!venv/**",
      "!**/__pycache__/**",
      "!*.pyc",
      "!*.spec",
      "!*.db"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "static",
        "to": "static",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterSign": "scripts/afterSign.js",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "KSP GameStats ${version}",
      "icon": "build/icon.icns",
      "iconSize": 100,
      "background": "build/dmg-background.png",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KSP GameStats",
      "artifactName": "KSP-GameStats-Setup-${version}.exe"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KSP-GameStats-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.7.0",
    "puppeteer": "^25.14.0"
  }
}
